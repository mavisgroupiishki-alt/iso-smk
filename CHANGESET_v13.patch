+    if(key && index.has(key) && row && typeof row === 'object' && !Array.isArray(row)) {
+      const pos = index.get(key);
+      out[pos] = aiDeepMergeDefined(out[pos], row);
+    } else if(key && index.has(key)) {
+      out[index.get(key)] = row;
+    } else {
+      out.push(aiCloneForStorage(row));
+      if(key) index.set(key, out.length - 1);
+    }
+  });
+  return out;
