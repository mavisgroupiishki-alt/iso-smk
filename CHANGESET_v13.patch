+function aiCompactHistory(history) {
+  // Сырые тексты архивов могут занимать мегабайты и переполнить localStorage.
+  // В карточке сохраняются все структурированные данные; в локальной истории — только
+  // последние сообщения в компактном виде для восстановления интерфейса.
+  const rows = Array.isArray(history) ? history.slice(-40) : [];
+  let total = 0;
+  const result = [];
+  for (let i = rows.length - 1; i >= 0; i--) {
+    const row = rows[i] || {};
+    let content = String(row.content || '');
+    content = content
+      .replace(/===\s*📦?\s*СОСТАВ АРХИВА[\s\S]*?(?=\n===|\nЗАПРОС:|$)/gi, '[состав архива сохранён в структурированных данных]')
