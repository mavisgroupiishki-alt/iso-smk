+def _ru_count(value: int, one: str, few: str, many: str) -> str:
+    n = abs(int(value))
+    if 11 <= n % 100 <= 14:
+        word = many
+    elif n % 10 == 1:
+        word = one
+    elif n % 10 in (2, 3, 4):
+        word = few
+    else:
+        word = many
+    return f'{value} {word}'
