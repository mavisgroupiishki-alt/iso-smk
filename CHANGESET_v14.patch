+// ── ЗНАНИЯ ИИГОРЯ ─────────────────────────────────────────────
+let knowledgeRules = [];
+let knowledgeSourceText = '';
+let knowledgeSourceFilename = '';
+let knowledgePageInitialized = false;
+
+function igorEscape(value) {
+  return String(value == null ? '' : value)
+    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
+    .replace(/"/g,'&quot;').replace(/'/g,'&#039;');
+}
+
+async function knowledgePost(path, payload) {
+  const response = await fetch(path, {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload || {})});
+  const data = await response.json();
+  if(!response.ok || data.success === false) throw new Error(data.error || `HTTP ${response.status}`);
+  return data;
+}
+
+function knowledgeInitPage() {
+  const author = document.getElementById('knowledge-author');
+  if(author && !author.value) {
+    try { author.value = localStorage.getItem('igor:knowledge:author') || ''; } catch(_) {}
+  }
+  knowledgePageInitialized = true;
+  knowledgeLoadRules();
+}
+
+async function knowledgeReadSelectedFile(file) {
+  knowledgeSourceText = '';
+  knowledgeSourceFilename = '';
+  const status = document.getElementById('knowledge-file-status');
+  if(!file) { if(status) status.textContent=''; return; }
+  if(status) status.textContent = `⏳ Читаю «${file.name}»...`;
+  try {
+    const result = await aiReadFile(file);
+    knowledgeSourceText = result.content || '';
+    knowledgeSourceFilename = file.name;
+    if(status) status.textContent = `✅ «${file.name}» прочитан, ${knowledgeSourceText.length.toLocaleString('ru-RU')} знаков`;
+  } catch(e) {
+    if(status) status.textContent = '❌ ' + e.message;
+  }
+}
+
+function knowledgeScopeLabel(scope) {
+  const labels = {all:'Все продукты',iso:'ISO 9001',suot:'СУОТ',iso_suot:'ISO + СУОТ',spk:'Все СПК',spk_stroy:'СПК Стройкомплекс',spk_bisp:'СПК БИСП',company_att:'Аттестация компании',att:'Аттестация специалиста',periodika:'Периодика'};
+  return labels[scope] || scope || 'Все продукты';
+}
+
+function knowledgeRulePreviewHtml(rule, chatMode=false) {
+  const cond = (rule.conditions || []).map(v=>`<li>${igorEscape(v)}</li>`).join('');
+  const acts = (rule.actions || []).map(v=>`<li>${igorEscape(v)}</li>`).join('');
+  const conflict = rule.conflict_warning ? `<div style="margin-top:8px;padding:8px;border-radius:6px;background:#FFF0ED;color:#A6503D"><b>⚠️ Возможный конфликт:</b> ${igorEscape(rule.conflict_warning)}</div>` : '';
+  const controls = rule.active
+    ? `<button class="igor-btn soft" onclick="knowledgeSetActive('${rule.id}',false)">Отключить</button>`
+    : `<button class="igor-btn green" onclick="knowledgeSetActive('${rule.id}',true)">✅ Подтвердить обучение</button>`;
+  return `<div class="knowledge-rule ${rule.active?'':'draft'}" id="knowledge-rule-${rule.id}">
+    <div style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start"><div><b style="color:#8B4A5C">${igorEscape(rule.title)}</b><div style="margin-top:4px"><span class="knowledge-pill">${igorEscape(knowledgeScopeLabel(rule.scope))}</span><span class="knowledge-pill">версия ${Number(rule.version||1)}</span></div></div><span style="font-size:10px;color:#A8938A">${igorEscape(rule.author||'')}</span></div>
+    <div style="font-size:12px;line-height:1.5;margin-top:9px;white-space:pre-wrap">${igorEscape(rule.instruction)}</div>
+    ${cond?`<div style="font-size:11px;margin-top:7px"><b>Когда применять:</b><ul style="margin:4px 0 0 18px">${cond}</ul></div>`:''}
+    ${acts?`<div style="font-size:11px;margin-top:7px"><b>Что делать:</b><ul style="margin:4px 0 0 18px">${acts}</ul></div>`:''}
+    ${rule.source_filename?`<div style="font-size:10px;color:#8B7E76;margin-top:6px">Источник: ${igorEscape(rule.source_filename)}</div>`:''}
+    ${conflict}
+    <div style="display:flex;gap:7px;margin-top:10px;flex-wrap:wrap">${controls}${chatMode?'':`<button class="igor-btn soft" onclick="knowledgeEditRule('${rule.id}')">Редактировать</button><button class="igor-btn danger" onclick="knowledgeDeleteRule('${rule.id}')">Удалить</button>`}</div>
+  </div>`;
+}
+
+async function knowledgePreviewRule() {
+  const instruction = (document.getElementById('knowledge-instruction')?.value || '').trim();
+  const scope = document.getElementById('knowledge-scope')?.value || 'all';
+  const author = (document.getElementById('knowledge-author')?.value || '').trim() || 'Пользователь ИИгоря';
+  try { localStorage.setItem('igor:knowledge:author', author); } catch(_) {}
+  const box = document.getElementById('knowledge-preview');
+  if(box) box.innerHTML = '<div style="font-size:11px;color:#A8938A">⏳ ИИгорь формулирует правило и проверяет конфликты...</div>';
+  try {
+    const data = await knowledgePost('/api/knowledge/preview', {instruction, scope, author, source_filename:knowledgeSourceFilename, source_text:knowledgeSourceText});
+    if(box) box.innerHTML = `<div style="font-size:10px;color:#A8938A;margin-bottom:6px">Проверьте формулировку. Правило начнёт действовать только после подтверждения.</div>${knowledgeRulePreviewHtml(data.rule)}`;
+    await knowledgeLoadRules();
+  } catch(e) {
+    if(box) box.innerHTML = `<div style="color:#A6503D;font-size:11px">❌ ${igorEscape(e.message)}</div>`;
+  }
+}
+
+function knowledgeClearForm() {
+  const ids=['knowledge-instruction','knowledge-file'];
+  ids.forEach(id=>{const el=document.getElementById(id); if(el) el.value='';});
+  knowledgeSourceText=''; knowledgeSourceFilename='';
+  const status=document.getElementById('knowledge-file-status'); if(status) status.textContent='';
+  const preview=document.getElementById('knowledge-preview'); if(preview) preview.innerHTML='';
+}
+
+async function knowledgeLoadRules() {
+  try {
+    const response = await fetch('/api/knowledge/list');
+    const data = await response.json();
+    knowledgeRules = data.rules || [];
+    knowledgeRenderRules();
+  } catch(e) {
+    const box=document.getElementById('knowledge-rules-list'); if(box) box.innerHTML=`<div style="color:#A6503D">${igorEscape(e.message)}</div>`;
+  }
+}
+
+function knowledgeRenderRules() {
+  const box=document.getElementById('knowledge-rules-list'); if(!box) return;
