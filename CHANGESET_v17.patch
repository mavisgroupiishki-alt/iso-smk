+function aiFriendlyError(value) {
+  const text = String(value || '').trim();
+  if(!text) return 'Не удалось выполнить действие. Попробуйте ещё раз.';
+  const low = text.toLowerCase();
+  if(low.includes('другая генерация') || low.includes('уже формируется')) return 'Уже формируется другой пакет. Дождитесь его завершения и попробуйте снова.';
+  if(low.includes('название компании')) return 'Не удалось определить название компании. Проверьте карточку компании и повторите формирование.';
+  const technical = /(json|api|http|backend|frontend|hardcoded|force[_-]?|render|environment|traceback|stack|vibe_api_key|bad json|empty response)/i;
+  if(technical.test(text) || text.length > 280) return 'Не удалось выполнить действие. Попробуйте ещё раз. Если ошибка повторится, сообщите ответственному за приложение.';
+  return text;
+}
